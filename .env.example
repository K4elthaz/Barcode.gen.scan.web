# Firebase — now used ONLY for email/password authentication.
# Get these from your Firebase project: Console → Project settings → General.
# (database_url / storage_bucket are left over from the RTDB + Firebase Storage
# migration and are no longer required by the app.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Supabase (used for item/category/supplier image uploads)
# Project Settings → API → Project URL and anon public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Google Maps API key, used only for reverse geocoding item locations.
# If omitted, location falls back to a BigDataCloud lookup / coordinate text.
VITE_GOOGLE_MAPS_API_KEY=